# frontend/.env
# Copy this to .env and adjust if needed

VITE_API_BASE_URL=http://localhost:8000

# Auth mode: "dev" uses X-Dev-User header stub; "entra" uses Azure Entra ID MSAL.
# Must mirror the backend's ENVIRONMENT setting (dev ↔ dev_auth.py, entra ↔ entra.py).
VITE_AUTH_MODE=dev

# Dev auth: this username is sent as X-Dev-User header on every request.
# Only used when VITE_AUTH_MODE=dev. Must match a Username in tblUser.
VITE_DEV_USER=admin

# Entra ID settings — only required when VITE_AUTH_MODE=entra.
VITE_ENTRA_CLIENT_ID=your-frontend-app-registration-client-id
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/your-tenant-id
VITE_API_SCOPE=api://sfms-api/forecast.readwrite
