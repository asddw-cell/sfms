# backend/.env
# Copy this file to .env and fill in your values

# SQL Server connection
# Use Windows Authentication (trusted connection) - no username/password needed
DB_SERVER=NLREPORTING-DTA
DB_NAME=SalesForecast
DB_DRIVER=ODBC Driver 17 for SQL Server

# Set to "dev" to enable the auth stub (no Entra ID required)
ENVIRONMENT=dev

# Frontend URL for CORS
ALLOWED_ORIGINS=http://localhost:3000

# Dev auth stub - username to use when ENVIRONMENT=dev
# Must match a Username in tblUser in your database
DEV_USER=admin

# Supply forecast settings
SUPPLY_HORIZON_DEFAULT_MONTHS=3
SYSTEM_USER_ID=1
